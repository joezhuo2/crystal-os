# --- Supabase ---
# From Supabase Dashboard -> Project Settings -> API.
# VITE_-prefixed, so both values ARE inlined into the client bundle and are
# public at runtime. That is expected for the anon key. Row Level Security on
# every table is what actually protects your data.
# NEVER put the service_role key in a VITE_ variable, or in this repo at all.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Absolute path to your Obsidian vault. Use forward slashes on Windows.
# Read server-side only (see server/obsidian/plugin.ts) — deliberately NOT
# VITE_-prefixed so it is never inlined into the client bundle.
OBSIDIAN_VAULT_PATH=

# --- Google Calendar (The Horizon) ---
# From a Google Cloud OAuth client of type "Web application", with the Google
# Calendar API enabled. Server-side only, for the same reason as above: the
# client secret and refresh token must never reach the browser bundle.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Packaged desktop app: in %APPDATA%\com.crystalos.desktop\.env.local use
# http://127.0.0.1:8787/api/calendar/auth/callback instead (and authorize it).
GOOGLE_REDIRECT_URI=http://localhost:8080/api/calendar/auth/callback
# Written automatically by the server after you click Connect. Leave blank.
GOOGLE_REFRESH_TOKEN=

# --- Mail digest (read-only Gmail and Outlook) ---
# One redirect URI for BOTH providers. Add it to the Google OAuth client above
# AND to the Azure app registration. Packaged desktop app: use
# http://127.0.0.1:8787/api/mail/auth/callback instead (and authorize it).
MAIL_REDIRECT_URI=http://localhost:8080/api/mail/auth/callback
# Gmail reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET; enable the Gmail API on
# the same Google Cloud project. Only the gmail.readonly scope is requested.
# Outlook: an Azure app registration (Microsoft Entra ID) allowing personal and
# work accounts, with the delegated Mail.Read and User.Read permissions. Sign-in
# always uses PKCE; the secret is only needed for a "Web" platform registration.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Connected accounts and their refresh tokens are kept in mail-accounts.json
# next to this file, never in the browser.
# Optional. With a key set, the sender, subject and preview of emails the rules
# are unsure about are sent to Anthropic to classify them. Leave blank to keep
# everything local.
ANTHROPIC_API_KEY=
MAIL_AI_MODEL=claude-haiku-5-5

# --- E2E smoke test (npm run test:e2e) ---
# A separate test user created in the Supabase dashboard, not your own account:
# the test adds a task and a transaction to it and deletes them again. Read by
# playwright.config.ts only; never VITE_-prefixed.
E2E_EMAIL=
E2E_PASSWORD=
