# --- Supabase ---
# From Supabase Dashboard -> Project Settings -> API.
# VITE_-prefixed, so both values ARE inlined into the client bundle and are
# public at runtime. That is expected for the anon key. Row Level Security on
# every table is what actually protects your data.
# NEVER put the service_role key in a VITE_ variable, or in this repo at all.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Absolute path to your Obsidian vault. Use forward slashes on Windows.
# Read server-side only (see server/obsidian/plugin.ts) — deliberately NOT
# VITE_-prefixed so it is never inlined into the client bundle.
OBSIDIAN_VAULT_PATH=

# --- Google Calendar (The Horizon) ---
# From a Google Cloud OAuth client of type "Web application", with the Google
# Calendar API enabled. Server-side only, for the same reason as above: the
# client secret and refresh token must never reach the browser bundle.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/calendar/auth/callback
# Written automatically by the server after you click Connect. Leave blank.
GOOGLE_REFRESH_TOKEN=
