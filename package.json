{
  "name": "crystal-os",
  "private": true,
  "version": "0.8.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:rls": "vite-node scripts/verify-rls.ts",
    "badges": "node scripts/update-badges.mjs",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "prune:bundles": "node scripts/prune-bundles.mjs",
    "build:desktop": "npm run prune:bundles && npm run build:sidecar && tauri build --config src-tauri/tauri.bundle.conf.json",
    "build:release": "npm run prune:bundles && npm run build:sidecar && tauri build --config src-tauri/tauri.bundle.conf.json --config src-tauri/tauri.release.conf.json && node scripts/updater-manifest.mjs"
  },
  "dependencies": {
