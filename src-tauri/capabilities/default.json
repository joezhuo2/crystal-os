{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions. No shell, fs, or dialog plugin access for the webview: the sidecar is spawned from Rust, and the vault is only reachable through the vault commands, which confine every path to the folder the user picked (src-tauri/src/vault.rs). Portal webviews load remote https sites; this capability has no remote entry, so those pages cannot call any command (src-tauri/src/portal.rs). The Terminal tab can run anything the user types: the terminal commands drive up to five shells spawned from Rust (src-tauri/src/terminal.rs). The Nebula tab runs coding agents in folders the user picks: Rust spawns DeepSeek Harness (node) and the claude CLI with argument lists built from validated enums, ids, and paths; API keys and MCP server env values stay in Rust and are never returned to the webview (src-tauri/src/harness/).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://accounts.google.com/*" }]
    },
    "allow-get-global-shortcut",
    "allow-set-global-shortcut",
    "allow-pause-global-shortcut",
    "allow-get-launch-at-login",
    "allow-set-launch-at-login",
    "allow-update-tray-pomodoro",
    "allow-get-vault-status",
    "allow-pick-vault",
    "allow-list-vault",
    "allow-read-vault-file",
    "allow-write-vault-file",
    "allow-watch-vault",
    "allow-terminal-list",
    "allow-terminal-open",
    "allow-terminal-attach",
    "allow-terminal-restart",
    "allow-terminal-close",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-portal-show",
    "allow-portal-hide",
    "allow-portal-snapshot",
    "allow-portal-fade-out",
    "allow-portal-nav",
    "allow-portal-open-external",
    "allow-portal-sign-out",
    "allow-portal-remove",
    "allow-portal-prune",
    "allow-portal-rebuild",
    "allow-portal-unload",
    "allow-harness-env-status",
    "allow-harness-install-runtime",
    "allow-harness-get-config",
    "allow-harness-set-config",
    "allow-harness-set-key",
    "allow-harness-discover",
    "allow-harness-probe",
    "allow-harness-dsh-start",
    "allow-harness-acp-open-session",
    "allow-harness-claude-start",
    "allow-harness-send",
    "allow-harness-kill",
    "allow-harness-reset",
    "allow-harness-pick-folder",
    "allow-harness-create-project",
    "allow-harness-state-load",
    "allow-harness-state-save",
    "allow-harness-chat-load",
    "allow-harness-chat-save",
    "allow-harness-chat-delete",
    "allow-installer-status",
    "allow-installer-releases",
    "allow-installer-download",
    "allow-installer-pick-source",
    "allow-installer-build",
    "allow-installer-cancel-build",
    "allow-installer-reveal"
  ]
}
