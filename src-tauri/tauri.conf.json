{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Crystal OS",
  "version": "0.9.5",
  "identifier": "com.crystalos.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Crystal OS",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "visible": false,
        "backgroundColor": "#0f172a",
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,BackForwardCache"
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8787 https://*.supabase.co wss://*.supabase.co https://api.weather.gc.ca",
        "img-src": "'self' data: blob: https:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDMzI2N0NFQTJDRkY0QTkKUldTcDlNK2l6bWN5TEFHYUg4SURMRG9sdGdVYWtUL1lqcDNCTURTYi9kdmVKREl4dHZrWnhQWEsK",
      "endpoints": ["https://github.com/joezhuo2/crystal-os/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
